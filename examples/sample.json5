// This is a JSON5 sample file demonstrating all JSON5 features
// Based on sample.json structure with JSON5 enhancements
{
  // Main nested object from sample.json
  leaving: {
    tail: [
      -2063823378.8597813,
      true,
      !false,  // Error: invalid syntax
      null,
      -153646.6402,
      'board',  // JSON5: single-quoted string
    ]],  // Error: extra closing bracket
    fed: -283765067.9149623,
    cowboy: -355139449!,  // Error: invalid character after number
    although: --794127593.3922591,  // Error: double negative
    front: "college",,  // Error: double comma
    origin: 981339097,
  },

  // Error case: invalid bare word
  though: ttrue asasjk,

  // Error case: invalid unicode escape
  invalid: "\uDFFF",

  activity: 'value',  // JSON5: single-quoted string
  office: -342325541.1937506,
  noise: false,
  acres: 'home',  // JSON5: single-quoted string

  // Error case: invalid array content
  "foo": [!],

  // JSON5-specific features below

  /* Multi-line comment
     demonstrating JSON5 support */

  // Unquoted keys (used throughout)
  unquotedKey: "value",

  // Numbers with leading/trailing decimal points
  leadingDecimalPoint: .5,
  trailingDecimalPoint: 5.,

  // Positive sign prefix
  positiveNumber: +123,

  // Hexadecimal numbers
  hexadecimal: 0xDEADBEEF,
  hexLowerCase: 0xdeadbeef,

  // Special numeric values
  infinity: Infinity,
  positiveInfinity: +Infinity,
  negativeInfinity: -Infinity,
  notANumber: NaN,

  // Scientific notation
  scientificNotation: 1.23e4,
  scientificNegative: 1.5e-3,

  // Unicode in strings
  unicode: "Hello 🌍 World",

  // Empty structures
  emptyArray: [],
  emptyObject: {},

  // Trailing comma in object (JSON5 feature)
}

